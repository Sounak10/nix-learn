# INTENTIONAL IFD AND IMPURITY.
# This uses <nixpkgs>, realizes generated during evaluation, and is deliberately
# not imported by the root flake or its automatic checks.
{
  pkgs ? import <nixpkgs> { },
}:

let
  generated = pkgs.runCommand "advanced-evaluation-generated.nix" { } ''
    cat > "$out" <<'EOF'
    {
      answer = 42;
      warning = "generated by import from derivation";
    }
    EOF
  '';
in
import generated
