#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

echo "==> syntax"
while IFS= read -r file; do
  nix-instantiate --parse "$file" >/dev/null
done < <(
  find examples exercises projects solutions tracks \
    -type f -name '*.nix' -print | sort
)

echo "==> evaluations"
test "$(nix eval --raw .#lib.languageResult)" = "hello, NIX!"
nix eval --json .#lib.moduleResult | grep -q '"port":8080'
nix eval --json .#lib.homeManagerResult | grep -q '"programs"'
nix eval --json .#lib.nixosEvaluations.x86_64-linux | grep -q '"hostName":"nix-lab"'
test "$(nix eval --raw --file examples/advanced-evaluation/safe-pure-data.nix \
  --apply 'value: builtins.concatStringsSep "," value.enabledNames')" = "alpha,gamma"
nix eval --json --file examples/advanced-evaluation/safe-source-filter.nix \
  | grep -q '"files":\["kept.txt"\]'

echo "==> flake checks"
nix flake check --print-build-logs
nix flake check "path:$PWD/projects/hello-service" --print-build-logs
nix flake check "path:$PWD/tracks/macos" --all-systems --no-build

echo "==> package and app links"
out_links="$(mktemp -d)"
trap 'rm -rf "$out_links"' EXIT
nix build .#hello --out-link "$out_links/hello"
nix build .#app --out-link "$out_links/app"
test -x "$out_links/hello/bin/nix-lab-hello"
test -x "$out_links/app/bin/nix-lab-app"
test "$(nix run .#app)" = "nix lab app"

echo "All lab checks passed."
